<% layout("/layout/boilerplate") %>
<div class="row mt-5">
    <h1 class="text-center">Welcome to Sentiment Tool</h1>
        <div class="col-6 offset-3" >
            <p class="lead">Welcome to the Sentiment Tool! This platform allows students to submit feedback on faculty and courses, while faculty members can view sentiment analytics based on the feedback received. Admins have access to system-wide analytics and can run sentiment analysis pipelines.</p>
            <p class="lead">To get started, please <span class="text-success">log in </span> or <span class="text-success">sign up</span> for an account.</p>
        </div>

        <div class="col-6 offset-3 mt-4">
            <a href="/signup"><button class="btn btn-success me-2">SignUp</button></a>
            <a href="/login"><button class="btn btn-success">LogIn</button></a>
        </div>
</div>
